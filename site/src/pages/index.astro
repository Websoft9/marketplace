---
import DashboardLayout from "../layouts/DashboardLayout.astro";
import StatCard from "../components/StatCard.astro";
import StoreLinks from "../components/StoreLinks.astro";
import { CATALOG_URL, OFFER_URL, OVERVIEW_PLATFORMS } from "../lib/config";

const basePath = import.meta.env.BASE_URL.replace(/\/+$/, "");
const appsHref = `${basePath}/apps`;
---

<DashboardLayout
  title="市场总览 | Websoft9 Marketplace"
  description="Websoft9 Marketplace 应用上架概况、平台覆盖和数据源状态。"
>
  <header class="page-header">
    <div>
      <span class="eyebrow">Overview / Marketplace</span>
      <h1>Marketplace 总览</h1>
      <p class="lede">
        汇总应用目录与各云平台 Marketplace 商品数据。需要查看具体应用时，再进入应用列表。
      </p>
    </div>
    <div class="header-meta">
      <span class="build-pill" data-data-status>正在加载数据（首次需从上游下载）…</span>
      <button class="button" type="button" data-refresh>刷新</button>
      <a class="button" href={appsHref}>查看应用列表</a>
    </div>
  </header>

  <div class="data-alert" data-data-alert hidden></div>

  <section class="stats-grid" aria-label="应用统计">
    <StatCard label="商品目录应用" value="—" hint="product_en.json" tone="blue" statKey="catalog" />
    <StatCard label="已上架" value="—" hint="至少有一个 Marketplace 商品" tone="green" statKey="listed" />
    <StatCard label="未上架" value="—" hint="目录中但暂无商品" tone="amber" statKey="unlisted" />
    <StatCard label="目录外商品" value="—" hint="offer-codes 中存在但无 Trademark" tone="slate" statKey="outside" />
  </section>

  <section class="insight-grid">
    <article class="panel coverage-panel">
      <div class="panel-heading">
        <div>
          <h2>平台覆盖</h2>
          <p>按已上架应用统计各 Marketplace 的覆盖数量。</p>
        </div>
        <span class="subtle" data-listing-rate>上架率 —</span>
      </div>
      <div class="coverage-list">
        {OVERVIEW_PLATFORMS.map((platform) => (
          <div class="coverage-row" data-coverage={platform.key}>
            <div class="coverage-meta">
              <span>
                <strong>{platform.label}</strong>
                <StoreLinks stores={platform.stores ?? []} />
                <small>{platform.description}</small>
              </span>
              <span data-coverage-count>—</span>
            </div>
            <div class="bar" aria-hidden="true">
              <span data-coverage-bar style="width: 0%"></span>
            </div>
          </div>
        ))}
      </div>
    </article>

    <article class="panel source-panel">
      <div class="panel-heading">
        <div>
          <h2>数据源</h2>
          <p>页面加载时由浏览器直接获取公开 JSON，并保存在本地缓存中。</p>
        </div>
      </div>
      <div class="source-list">
        <a class="source-item" href={OFFER_URL} target="_blank" rel="noreferrer">
          <span class="source-name">matrix.json</span>
          <span class="source-desc">商品编码与云平台映射</span>
        </a>
        <a class="source-item" href={CATALOG_URL} target="_blank" rel="noreferrer">
          <span class="source-name">product_en.json</span>
          <span class="source-desc">应用目录与 Trademark</span>
        </a>
      </div>
      <p class="source-note">
        数据源地址来自 `config/sources.json`（应用目录为 `sources.catalog.url`，商品编码为
        `sources.offer-codes.url`）。浏览器使用本地缓存和条件请求检查更新，数据变化后无需重新构建站点。
      </p>
    </article>
  </section>

  <section class="panel cta-panel">
    <div>
      <span class="eyebrow">Applications</span>
      <h2>需要查看具体应用？</h2>
      <p data-cta-text>
        应用列表包含目录应用和目录外商品，可按状态、平台和关键字筛选。
      </p>
    </div>
    <a class="button primary" href={appsHref}>打开应用列表</a>
  </section>
</DashboardLayout>

<script>
  import { loadMarketplaceData } from "../lib/client/data";
  import {
    describeStatus,
    errorMessage,
    hideDataError,
    setText,
    showDataError,
    wireRefreshButtons,
  } from "../lib/client/dom";
  import type { MarketplaceData } from "../lib/marketplace";
  import type { ResourceMeta } from "../lib/client/cache";

  const statusEl = document.querySelector<HTMLElement>("[data-data-status]");
  const alertEl = document.querySelector<HTMLElement>("[data-data-alert]");
  const coverageRows = new Map(
    Array.from(document.querySelectorAll<HTMLElement>("[data-coverage]")).map(
      (row) => [row.dataset.coverage ?? "", row],
    ),
  );

  function updateStatus(status: ResourceMeta): void {
    if (!statusEl) return;
    statusEl.textContent = describeStatus(status);
    statusEl.classList.toggle("is-stale", status.stale);
  }

  function render(data: MarketplaceData, status: ResourceMeta): void {
    const { stats } = data;
    setText(document, "[data-stat='catalog']", stats.catalog);
    setText(document, "[data-stat='listed']", stats.listed);
    setText(document, "[data-stat='unlisted']", stats.unlisted);
    setText(document, "[data-stat='outside']", stats.outside);

    const listingRate = stats.catalog
      ? Math.round((stats.listed / stats.catalog) * 100)
      : 0;
    setText(document, "[data-listing-rate]", `上架率 ${listingRate}%`);

    for (const platform of stats.platformCounts) {
      const row = coverageRows.get(platform.key);
      if (!row) continue;
      const percentage = stats.listed
        ? Math.round((platform.count / stats.listed) * 100)
        : 0;
      setText(row, "[data-coverage-count]", platform.count);
      const bar = row.querySelector<HTMLElement>("[data-coverage-bar]");
      if (bar) bar.style.width = `${percentage}%`;
    }

    const cta = document.querySelector<HTMLElement>("[data-cta-text]");
    if (cta) {
      cta.textContent = `应用列表包含 ${stats.catalog} 个目录应用和 ${stats.outside} 个目录外商品，可按状态、平台和关键字筛选。`;
    }

    updateStatus(status);

    hideDataError(alertEl);
  }
  wireRefreshButtons();

  loadMarketplaceData({ onUpdate: render, onRefresh: updateStatus })
    .then(({ data, status }) => render(data, status))
    .catch((error: unknown) => {
      if (statusEl) statusEl.textContent = "数据加载失败";
      showDataError(alertEl, errorMessage(error));
    });
</script>
