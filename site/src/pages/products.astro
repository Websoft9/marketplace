---
import DashboardLayout from "../layouts/DashboardLayout.astro";
import { ALL_PLATFORMS } from "../lib/config";

const basePath = import.meta.env.BASE_URL.replace(/\/+$/, "");
const appsHref = `${basePath}/apps`;
const offerUpdateHref =
  "https://github.com/Websoft9/marketplace/actions/workflows/offer-update.yml";
const metadataIssueHref = "https://github.com/Websoft9/marketplace/issues";
const platformOrder = [
  "aws",
  "azure",
  "azure-vmlab",
  "googlecloud",
  "alibabacloud",
  "aliyun",
  "huaweicloud",
  "huaweiyun",
];
const platformOrderIndex = new Map(
  platformOrder.map((key, index) => [key, index]),
);
const orderedPlatforms = [...ALL_PLATFORMS].sort(
  (a, b) =>
    (platformOrderIndex.get(a.key) ?? platformOrder.length) -
      (platformOrderIndex.get(b.key) ?? platformOrder.length) ||
    a.label.localeCompare(b.label, "zh-CN"),
);
---

<DashboardLayout
  title="云商品列表 | Websoft9 Marketplace"
  description="按云平台查看 Websoft9 Marketplace 商品、应用匹配和商品 code。"
>
  <header class="page-header">
    <div>
      <span class="eyebrow">Products / Marketplace</span>
      <h1>云商品列表</h1>
      <p class="lede">以云市场店铺商品列表为视图的商品查看与运营快捷入口</p>
    </div>
    <div class="header-meta">
      <span class="build-pill" data-data-status>正在加载数据（首次需从上游下载）…</span>
      <button class="button" type="button" data-refresh>刷新</button>
      <a class="button" href={appsHref}>应用列表</a>
    </div>
  </header>

  <div class="data-alert" data-data-alert hidden></div>

  <div class="product-overview" aria-label="商品总览">
    <span class="summary-pill"><strong data-total="platforms">—</strong> 个云平台</span>
    <span class="summary-pill"><strong data-total="products">—</strong> 个商品</span>
    <span class="summary-pill">
      <strong data-total="matched">—</strong> 个已匹配商品
    </span>
    <span class="summary-pill"><strong data-total="apps">—</strong> 个应用</span>
    <span class="summary-note" data-totals-note hidden></span>
  </div>

  <section class="panel products-panel">
    <div class="product-tabs" role="tablist" aria-label="云平台" data-product-tabs>
      {orderedPlatforms.map((platform, index) => (
        <button
          type="button"
          role="tab"
          id={`tab-${platform.key}`}
          class:list={["product-tab", { active: index === 0 }]}
          aria-controls={`panel-${platform.key}`}
          aria-selected={index === 0 ? "true" : "false"}
          tabindex={index === 0 ? 0 : -1}
          data-product-tab={platform.key}
        >
          <span>{platform.label}</span>
          <span class="tab-count">…</span>
        </button>
      ))}
    </div>

    <div data-product-panels></div>
  </section>

  <div
    class="row-actions-menu"
    role="menu"
    aria-label="商品操作"
    data-row-actions-menu
    hidden
  >
    <a
      role="menuitem"
      data-action="update-offer"
      href={offerUpdateHref}
      target="_blank"
      rel="noreferrer"
    >
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M12 20h9"></path>
        <path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z"></path>
      </svg>
      更新商品
    </a>
    <a
      role="menuitem"
      data-action="update-metadata"
      href={metadataIssueHref}
      target="_blank"
      rel="noreferrer"
    >
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8Z"></path>
        <path d="M14 2v6h6"></path>
        <path d="M8 13h8"></path>
        <path d="M8 17h8"></path>
      </svg>
      更新应用元数据
    </a>
    <a
      role="menuitem"
      data-action="search"
      href="#"
      target="_blank"
      rel="noreferrer"
      hidden
    >
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <circle cx="11" cy="11" r="7"></circle>
        <path d="m21 21-4.3-4.3"></path>
      </svg>
      云市场搜索
    </a>
  </div>
</DashboardLayout>

<script>
  import { loadMarketplaceData, loadPlatformProduct } from "../lib/client/data";
  import {
    describeStatus,
    errorMessage,
    hideDataError,
    html,
    setContent,
    setText,
    showDataError,
    wireCopyButtons,
    wireRefreshButtons,
    type SafeHtml,
  } from "../lib/client/dom";
  import type { ResourceMeta } from "../lib/client/cache";
  import type { PlatformProductData, PlatformProductRow } from "../lib/products";
  import type { StoreConfig } from "../lib/config";
  import { buildTotals } from "../lib/products";

  type SortKey = "title" | "app";

  const basePath = import.meta.env.BASE_URL.replace(/\/+$/, "");
  const sortDatasetKey: Record<SortKey, string> = {
    title: "sortTitle",
    app: "sortApp",
  };

  const tabs = Array.from(
    document.querySelectorAll<HTMLButtonElement>("[data-product-tab]"),
  );
  const tablist = document.querySelector<HTMLElement>("[data-product-tabs]");
  const panelsHost = document.querySelector<HTMLElement>("[data-product-panels]");
  const statusEl = document.querySelector<HTMLElement>("[data-data-status]");
  const alertEl = document.querySelector<HTMLElement>("[data-data-alert]");
  const actionsMenu = document.querySelector<HTMLElement>(
    "[data-row-actions-menu]",
  );

  const panels = new Map<string, HTMLElement>();
  const platformData = new Map<string, PlatformProductData>();
  const pendingLoads = new Map<string, Promise<void>>();
  const panelReady = new Set<string>();

  let currentKey: string | undefined;
  let openActionsToggle: HTMLButtonElement | null = null;
  let lastStatus: ResourceMeta = { fetchedAt: 0, stale: false };

  function reportStatus(status: ResourceMeta): void {
    lastStatus = {
      fetchedAt: Math.max(lastStatus.fetchedAt, status.fetchedAt),
      stale: status.stale,
    };
    if (statusEl) {
      statusEl.textContent = describeStatus(lastStatus);
      statusEl.classList.toggle("is-stale", lastStatus.stale);
    }
  }

  function panelElement(key: string): HTMLElement {
    const existing = panels.get(key);
    if (existing) return existing;

    const panel = document.createElement("section");
    panel.className = "product-panel";
    panel.id = `panel-${key}`;
    panel.setAttribute("role", "tabpanel");
    panel.setAttribute("aria-labelledby", `tab-${key}`);
    panel.dataset.productPanel = key;
    panel.hidden = true;
    panelsHost?.appendChild(panel);
    panels.set(key, panel);
    return panel;
  }

  function tabLabel(key: string): string {
    const tab = tabs.find((item) => item.dataset.productTab === key);
    return tab?.querySelector("span")?.textContent?.trim() || key;
  }

  function updateTabCount(key: string, data?: PlatformProductData): void {
    const tab = tabs.find((item) => item.dataset.productTab === key);
    const count = tab?.querySelector<HTMLElement>(".tab-count");
    if (count) count.textContent = data ? String(data.stats.total) : "…";
  }

  function updateTotals(): void {
    const loaded = [...platformData.values()];
    const totals = buildTotals(loaded);
    setText(document, "[data-total='platforms']", loaded.length || "—");
    setText(document, "[data-total='products']", loaded.length ? totals.products : "—");
    setText(
      document,
      "[data-total='matched']",
      loaded.length ? totals.matched + totals.mapped : "—",
    );
    setText(document, "[data-total='apps']", loaded.length ? totals.apps : "—");

    const note = document.querySelector<HTMLElement>("[data-totals-note]");
    if (note) {
      const finish = loaded.length === tabs.length;
      note.hidden = finish;
      note.textContent = finish
        ? ""
        : `正在加载其余平台（${loaded.length}/${tabs.length}）…`;
    }
  }

  function statCard(
    label: string,
    value: number,
    hint: string,
    tone: "blue" | "green" | "amber" | "slate",
    extra?: SafeHtml,
  ): SafeHtml {
    return html`
      <article class="stat-card tone-${tone}">
        <span class="stat-label">${label}</span>
        <strong class="stat-value">${value}</strong>
        <span class="stat-hint">${hint}</span>
        ${extra ?? ""}
      </article>
    `;
  }

  function productRow(
    row: PlatformProductRow,
    index: number,
    searchUrlPrefix: string | undefined,
  ): SafeHtml {
    const searchText = [
      row.title,
      row.appId,
      row.appName,
      row.code,
      row.shortDescription,
    ]
      .filter(Boolean)
      .join(" ")
      .toLowerCase();
    const searchTerm = row.appName ?? row.title;
    const searchHref = searchUrlPrefix
      ? `${searchUrlPrefix}${encodeURIComponent(searchTerm)}`
      : "";

    return html`
      <tr
        data-product-row
        data-index="${index}"
        data-search="${searchText}"
        data-match="${row.matchStatus}"
        data-sort-title="${row.title.toLowerCase()}"
        data-sort-app="${(row.appName ?? row.appId ?? "").toLowerCase()}"
        data-code="${row.code}"
        data-export-title="${row.title}"
        data-export-url="${row.url ?? ""}"
        data-app-id="${row.appId ?? ""}"
        data-app-name="${row.appName ?? ""}"
      >
        <td class="product-title-cell">
          ${row.url
            ? html`
                <a
                  class="product-title-link"
                  href="${row.url}"
                  target="_blank"
                  rel="noreferrer"
                  title="${row.shortDescription ?? ""}"
                >${row.title}</a>
              `
            : html`
                <span class="product-title-link" title="${row.shortDescription ?? ""}">${row.title}</span>
              `}
          <span class="product-code-line">
            <code class="product-code" title="${row.code}">${row.code}</code>
            <button
              class="icon-copy-button"
              type="button"
              data-copy="${row.code}"
              aria-label="复制商品 code ${row.code}"
              title="复制商品 code ${row.code}"
            >
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.9"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <rect x="9" y="9" width="11" height="11" rx="2"></rect>
                <path d="M5 15V6a2 2 0 0 1 2-2h9"></path>
              </svg>
            </button>
          </span>
        </td>
        <td class="product-app-cell">
          ${row.appId
            ? html`
                <span class="product-app-id">
                  ${row.appInCatalog
                    ? html`
                        <a
                          href="${basePath}/apps/detail/?key=${encodeURIComponent(row.appId)}"
                          title="查看 ${row.appName ?? row.appId} 应用详情"
                        >${row.appId}</a>
                      `
                    : html`<code>${row.appId}</code>`}
                  <button
                    class="icon-copy-button"
                    type="button"
                    data-copy="${row.appId}"
                    aria-label="复制应用 ID ${row.appId}"
                    title="复制应用 ID ${row.appId}"
                  >
                    <svg
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.9"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <rect x="9" y="9" width="11" height="11" rx="2"></rect>
                      <path d="M5 15V6a2 2 0 0 1 2-2h9"></path>
                    </svg>
                  </button>
                </span>
              `
            : html`<span class="empty-cell">—</span>`}
          ${row.appName && row.appName !== row.appId
            ? row.appWebsiteUrl
              ? html`
                  <a
                    class="product-app-name product-app-link"
                    href="${row.appWebsiteUrl}"
                    target="_blank"
                    rel="noreferrer"
                    title="打开 ${row.appName} 官网"
                  >${row.appName}</a>
                `
              : html`<span class="product-app-name">${row.appName}</span>`
            : ""}
        </td>
        <td class="product-actions-cell">
          <button
            class="row-actions-toggle"
            type="button"
            data-actions-toggle
            data-search-url="${searchHref}"
            aria-haspopup="menu"
            aria-expanded="false"
            aria-label="${row.title} 操作"
            title="操作"
          >
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <circle cx="12" cy="5" r="1.7"></circle>
              <circle cx="12" cy="12" r="1.7"></circle>
              <circle cx="12" cy="19" r="1.7"></circle>
            </svg>
          </button>
        </td>
      </tr>
    `;
  }

  function marketplaceName(store: StoreConfig): string {
    return store.label
      .replace(/\s*店铺$/, "")
      .replace(/\s*Seller Profile$/i, "")
      .trim();
  }

  function storeLinks(platform: PlatformProductData): SafeHtml {
    if (platform.stores.length === 0) return html``;

    return html`
      <span class="stat-stores">
        ${platform.stores.map(
          (store) => html`
            <a
              href="${store.url}"
              target="_blank"
              rel="noreferrer"
              title="访问 ${store.label}"
            >来自 ${marketplaceName(store)} Marketplace</a>
          `,
        )}
      </span>
    `;
  }

  function panelMarkup(platform: PlatformProductData): SafeHtml {
    const sourceHint =
      platform.source === "artifact"
        ? "来自在线商品制品"
        : platform.source === "matrix"
          ? "来自 offer 矩阵"
          : "无可用商品数据源";
    const emptyMessage =
      platform.rows.length > 0
        ? "没有匹配的商品，请调整搜索或筛选条件。"
        : platform.source === "unavailable"
          ? "该平台暂无可用的商品数据源。"
          : "该平台暂无可展示的商品。";

    return html`
      <div class="stats-grid product-stats" aria-label="${platform.label} 商品统计">
        ${statCard("商品总数", platform.stats.total, sourceHint, "blue", storeLinks(platform))}
        ${statCard(
          "已匹配商品",
          platform.stats.withApp,
          `${platform.stats.matched} 自动 · ${platform.stats.mapped} 映射`,
          "green",
        )}
        ${statCard("未匹配商品", platform.stats.unmatched, "需要人工确认应用归属", "amber")}
        ${statCard("覆盖应用", platform.stats.apps, "不同应用 ID", "slate")}
      </div>

      <div class="product-toolbar">
        <p class="table-summary" aria-live="polite">
          显示 <strong data-visible-count>${platform.rows.length}</strong> /
          ${platform.rows.length} 个商品
        </p>
        <div class="filters">
          <input
            type="search"
            data-product-search
            placeholder="关键字"
            aria-label="搜索商品"
            autocomplete="off"
          />
          <select data-product-status aria-label="匹配筛选">
            <option value="all">全部</option>
            <option value="matched">已匹配</option>
            <option value="unmatched">未匹配</option>
          </select>
          <button
            class="button export-markdown-button"
            type="button"
            data-export-markdown
            title="导出当前平台全部商品为 Markdown 表格"
            disabled=${platform.rows.length === 0}
          >
            导出
          </button>
        </div>
      </div>

      <div class="table-scroll product-table-scroll">
        <table class="product-table" data-product-table>
          <thead>
            <tr>
              <th scope="col" aria-sort="ascending" data-sort-header="title">
                <button class="sort-button" type="button" data-sort-key="title">
                  商品标题
                  <span class="sort-indicator" data-sort-indicator aria-hidden="true">↑</span>
                </button>
              </th>
              <th scope="col" aria-sort="none" data-sort-header="app">
                <button class="sort-button" type="button" data-sort-key="app">
                  应用
                  <span class="sort-indicator" data-sort-indicator aria-hidden="true">↕</span>
                </button>
              </th>
              <th scope="col">操作</th>
            </tr>
          </thead>
          <tbody>
            ${platform.rows.map((row, index) =>
              productRow(row, index, platform.searchUrlPrefix),
            )}
          </tbody>
        </table>
      </div>

      <div class="empty-state" data-product-empty hidden=${platform.rows.length > 0}>
        ${emptyMessage}
      </div>
    `;
  }

  function drawLoading(key: string): void {
    const panel = panelElement(key);
    setContent(
      panel,
      html`<div class="panel-loading">正在加载 ${tabLabel(key)} 商品数据…</div>`,
    );
  }

  function drawPanel(key: string, data: PlatformProductData): void {
    const panel = panelElement(key);
    setContent(panel, panelMarkup(data));
    setupPanel(panel);
    panelReady.add(key);
  }

  async function ensurePlatform(key: string): Promise<void> {
    if (platformData.has(key)) return;

    const pending = pendingLoads.get(key);
    if (pending) return pending;

    const load = (async () => {
      const { data, status } = await loadPlatformProduct(key, marketplacePromise, {
        onUpdate: (updated, meta) => {
          platformData.set(key, updated);
          updateTabCount(key, updated);
          reportStatus(meta);
          updateTotals();
          if (currentKey === key) {
            drawPanel(key, updated);
          } else {
            // Redraw from the new data the next time this tab is activated.
            panelReady.delete(key);
          }
        },
        onRefresh: reportStatus,
      });

      platformData.set(key, data);
      updateTabCount(key, data);
      reportStatus(status);
      updateTotals();
      hideDataError(alertEl);
      if (currentKey === key) drawPanel(key, data);
    })()
      .catch((error: unknown) => {
        drawFailure(key, errorMessage(error));
        showDataError(alertEl, errorMessage(error));
        if (statusEl) statusEl.textContent = "数据加载失败";
      })
      .finally(() => {
        pendingLoads.delete(key);
      });

    pendingLoads.set(key, load);
    return load;
  }

  function drawFailure(key: string, message: string): void {
    const panel = panelElement(key);
    setContent(
      panel,
      html`
        <div class="panel-loading">
          <strong>${tabLabel(key)} 商品数据加载失败。</strong>
          <p>${message}</p>
        </div>
      `,
    );
  }

  function showPanel(key: string): void {
    const panel = panelElement(key);
    panel.hidden = false;
    if (panelReady.has(key)) return;

    const data = platformData.get(key);
    if (data) {
      drawPanel(key, data);
      return;
    }

    drawLoading(key);
    void ensurePlatform(key);
  }

  function setupPanel(panel: HTMLElement): void {
    const table = panel.querySelector<HTMLTableElement>("[data-product-table]");
    const tbody = table?.tBodies[0];
    if (!tbody) return;
    const body = tbody;

    const rows = Array.from(body.rows);
    const search = panel.querySelector<HTMLInputElement>("[data-product-search]");
    const status = panel.querySelector<HTMLSelectElement>("[data-product-status]");
    const visibleCount = panel.querySelector<HTMLElement>("[data-visible-count]");
    const empty = panel.querySelector<HTMLElement>("[data-product-empty]");
    const exportButton = panel.querySelector<HTMLButtonElement>(
      "[data-export-markdown]",
    );
    const headers = Array.from(
      panel.querySelectorAll<HTMLTableCellElement>("th[data-sort-header]"),
    );
    let sortKey: SortKey = "title";
    let sortDir: "asc" | "desc" = "asc";

    function updateHeaders() {
      for (const header of headers) {
        const key = header.dataset.sortHeader as SortKey | undefined;
        const active = key === sortKey;
        header.setAttribute(
          "aria-sort",
          active ? (sortDir === "asc" ? "ascending" : "descending") : "none",
        );
        const indicator = header.querySelector<HTMLElement>(
          "[data-sort-indicator]",
        );
        if (indicator) {
          indicator.textContent = active ? (sortDir === "asc" ? "↑" : "↓") : "↕";
        }
      }
    }

    function apply() {
      const term = (search?.value ?? "").trim().toLowerCase();
      const match = status?.value ?? "all";
      const datasetKey = sortDatasetKey[sortKey];
      const sorted = rows.slice().sort((a, b) => {
        const aValue = a.dataset[datasetKey] ?? "";
        const bValue = b.dataset[datasetKey] ?? "";
        if (!aValue && bValue) return 1;
        if (aValue && !bValue) return -1;

        const compared = aValue.localeCompare(bValue, "zh-CN", {
          numeric: true,
          sensitivity: "base",
        });
        if (compared !== 0) {
          return sortDir === "asc" ? compared : -compared;
        }
        const aIndex = Number(a.dataset.index ?? 0);
        const bIndex = Number(b.dataset.index ?? 0);
        return sortDir === "asc" ? aIndex - bIndex : bIndex - aIndex;
      });

      const fragment = document.createDocumentFragment();
      let visible = 0;

      for (const row of sorted) {
        const matchesSearch =
          term.length === 0 || (row.dataset.search ?? "").includes(term);
        const matchesStatus =
          match === "all" ||
          (match === "matched"
            ? row.dataset.match !== "unmatched"
            : row.dataset.match === "unmatched");
        const show = matchesSearch && matchesStatus;
        row.hidden = !show;
        if (show) visible += 1;
        fragment.appendChild(row);
      }

      body.appendChild(fragment);
      if (visibleCount) visibleCount.textContent = String(visible);
      if (empty) empty.hidden = visible !== 0;
      if (exportButton) exportButton.disabled = rows.length === 0;
    }

    headers.forEach((header) => {
      const key = header.dataset.sortHeader as SortKey | undefined;
      if (!key || !(key in sortDatasetKey)) return;
      header
        .querySelector<HTMLButtonElement>("[data-sort-key]")
        ?.addEventListener("click", () => {
          if (sortKey === key) {
            sortDir = sortDir === "asc" ? "desc" : "asc";
          } else {
            sortKey = key;
            sortDir = "asc";
          }
          updateHeaders();
          apply();
        });
    });

    search?.addEventListener("input", debounce(apply, 120));
    status?.addEventListener("change", apply);
    exportButton?.addEventListener("click", () => {
      if (rows.length > 0) {
        exportMarkdown(panel.dataset.productPanel ?? "", rows);
      }
    });

    updateHeaders();
    apply();
  }

  function escapeMarkdown(value: string) {
    return value
      .replace(/\\/g, "\\\\")
      .replace(/\|/g, "\\|")
      .replace(/\[/g, "\\[")
      .replace(/\]/g, "\\]")
      .replace(/\r?\n/g, " ")
      .trim();
  }

  function exportMarkdown(platformKey: string, rows: HTMLTableRowElement[]) {
    const lines = [
      "| Product Title | App ID | App Trademark | Product Code |",
      "| --- | --- | --- | --- |",
    ];

    for (const row of rows) {
      const title = escapeMarkdown(row.dataset.exportTitle ?? "");
      const url = (row.dataset.exportUrl ?? "").replace(/[()]/g, (value) =>
        value === "(" ? "%28" : "%29",
      );
      const appId = escapeMarkdown(row.dataset.appId ?? "");
      const appName = escapeMarkdown(row.dataset.appName ?? "");
      const code = escapeMarkdown(row.dataset.code ?? "");
      const titleCell = url ? `[${title}](${url})` : title;
      lines.push(`| ${titleCell} | ${appId} | ${appName} | ${code} |`);
    }

    const blob = new Blob([`${lines.join("\n")}\n`], {
      type: "text/markdown;charset=utf-8",
    });
    const blobUrl = URL.createObjectURL(blob);
    const link = document.createElement("a");
    link.href = blobUrl;
    link.download = `products-${platformKey || "products"}-${new Date()
      .toISOString()
      .slice(0, 10)}.md`;
    document.body.appendChild(link);
    link.click();
    link.remove();
    window.setTimeout(() => URL.revokeObjectURL(blobUrl), 1000);
  }

  function closeActionsMenu(options: { focusToggle?: boolean } = {}) {
    if (!actionsMenu || !openActionsToggle) return;
    const toggle = openActionsToggle;
    openActionsToggle = null;
    actionsMenu.hidden = true;
    toggle.setAttribute("aria-expanded", "false");
    if (options.focusToggle) toggle.focus();
  }

  function positionActionsMenu(toggle: HTMLButtonElement) {
    if (!actionsMenu) return;
    const toggleRect = toggle.getBoundingClientRect();
    const menuRect = actionsMenu.getBoundingClientRect();
    let top = toggleRect.bottom + 6;
    if (top + menuRect.height > window.innerHeight - 8) {
      top = toggleRect.top - menuRect.height - 6;
    }
    const left = Math.max(
      12,
      Math.min(
        toggleRect.right - menuRect.width,
        window.innerWidth - menuRect.width - 12,
      ),
    );
    actionsMenu.style.top = `${Math.max(12, top)}px`;
    actionsMenu.style.left = `${left}px`;
  }

  function openActionsMenu(toggle: HTMLButtonElement) {
    if (!actionsMenu) return;
    if (openActionsToggle === toggle) {
      closeActionsMenu();
      return;
    }

    closeActionsMenu();
    openActionsToggle = toggle;

    const searchLink = actionsMenu.querySelector<HTMLAnchorElement>(
      '[data-action="search"]',
    );
    const searchUrl = toggle.dataset.searchUrl ?? "";
    if (searchLink) {
      searchLink.hidden = searchUrl.length === 0;
      searchLink.href = searchUrl || "#";
    }

    actionsMenu.hidden = false;
    toggle.setAttribute("aria-expanded", "true");
    positionActionsMenu(toggle);
    actionsMenu
      .querySelector<HTMLAnchorElement>('a[role="menuitem"]:not([hidden])')
      ?.focus();
  }

  function debounce(fn: () => void, wait: number): () => void {
    let timer: number | undefined;
    return () => {
      window.clearTimeout(timer);
      timer = window.setTimeout(fn, wait);
    };
  }

  function activate(
    key: string | undefined,
    options: { focus?: boolean; updateHash?: boolean; scroll?: boolean } = {},
  ) {
    const tab = tabs.find((item) => item.dataset.productTab === key) ?? tabs[0];
    const nextKey = tab?.dataset.productTab;
    if (!tab || !nextKey) return;

    currentKey = nextKey;

    for (const candidate of tabs) {
      const selected = candidate === tab;
      candidate.setAttribute("aria-selected", selected ? "true" : "false");
      candidate.tabIndex = selected ? 0 : -1;
      candidate.classList.toggle("active", selected);
    }

    for (const [panelKey, panel] of panels) {
      panel.hidden = panelKey !== nextKey;
    }

    showPanel(nextKey);

    if (options.focus) tab.focus();
    if (options.scroll) {
      tab.scrollIntoView({ block: "nearest", inline: "nearest" });
    }
    if (options.updateHash) {
      const hash = `#${encodeURIComponent(nextKey)}`;
      if (location.hash !== hash) {
        history.replaceState(null, "", hash);
      }
    }
  }

  const marketplacePromise = loadMarketplaceData({
    onUpdate: (_data, status) => {
      reportStatus(status);
    },
    onRefresh: reportStatus,
  });
  void marketplacePromise
    .then(({ status }) => reportStatus(status))
    .catch(() => {
      // Individual platform loads surface the failure in their own panel.
    });

  tabs.forEach((tab) => {
    tab.addEventListener("click", () => {
      activate(tab.dataset.productTab, { updateHash: true });
    });
  });

  tablist?.addEventListener("keydown", (event) => {
    if (!(event.target instanceof Element)) return;
    const current = event.target.closest<HTMLButtonElement>("[data-product-tab]");
    if (!current) return;
    const index = tabs.indexOf(current);
    if (index < 0) return;

    let nextIndex: number | undefined;
    if (event.key === "ArrowRight") nextIndex = (index + 1) % tabs.length;
    else if (event.key === "ArrowLeft") {
      nextIndex = (index - 1 + tabs.length) % tabs.length;
    } else if (event.key === "Home") nextIndex = 0;
    else if (event.key === "End") nextIndex = tabs.length - 1;

    if (nextIndex !== undefined) {
      event.preventDefault();
      activate(tabs[nextIndex]?.dataset.productTab, {
        focus: true,
        updateHash: true,
        scroll: true,
      });
    }
  });

  document.addEventListener("click", (event) => {
    if (!(event.target instanceof Element)) return;
    const toggle = event.target.closest<HTMLButtonElement>(
      "[data-actions-toggle]",
    );
    if (toggle) {
      event.preventDefault();
      openActionsMenu(toggle);
      return;
    }
    if (!event.target.closest("[data-row-actions-menu]")) {
      closeActionsMenu();
    }
  });

  actionsMenu?.addEventListener("click", (event) => {
    if (event.target instanceof Element && event.target.closest("a")) {
      closeActionsMenu();
    }
  });

  actionsMenu?.addEventListener("keydown", (event) => {
    if (event.key !== "ArrowDown" && event.key !== "ArrowUp") return;
    const items = Array.from(
      actionsMenu.querySelectorAll<HTMLAnchorElement>(
        'a[role="menuitem"]:not([hidden])',
      ),
    );
    if (items.length === 0) return;

    const current =
      document.activeElement instanceof HTMLAnchorElement
        ? items.indexOf(document.activeElement)
        : -1;
    const step = event.key === "ArrowDown" ? 1 : -1;
    const next =
      current < 0
        ? 0
        : (current + step + items.length) % items.length;
    event.preventDefault();
    items[next]?.focus();
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && openActionsToggle) {
      event.preventDefault();
      closeActionsMenu({ focusToggle: true });
    }
  });

  window.addEventListener("scroll", () => closeActionsMenu(), true);
  window.addEventListener("resize", () => closeActionsMenu());

  wireCopyButtons();
  wireRefreshButtons();

  const initialKey = decodeURIComponent(location.hash.replace(/^#/, ""));
  activate(initialKey || tabs[0]?.dataset.productTab);

  window.addEventListener("hashchange", () => {
    const key = decodeURIComponent(location.hash.replace(/^#/, ""));
    activate(key, { scroll: true });
  });

  // Load the active platform first, then fetch the remaining platforms in the
  // background (three at a time) so tab counts and totals fill in without
  // delaying the table or letting one slow platform block the others.
  void (async () => {
    const initial = currentKey;
    if (initial) await ensurePlatform(initial);

    const queue = tabs
      .map((tab) => tab.dataset.productTab)
      .filter((key): key is string => Boolean(key) && key !== initial);

    const workers = Array.from(
      { length: Math.min(3, queue.length) },
      async () => {
        while (queue.length > 0) {
          const key = queue.shift();
          if (key) await ensurePlatform(key);
        }
      },
    );
    await Promise.all(workers);
  })();
</script>
