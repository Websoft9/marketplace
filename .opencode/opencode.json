{
  "$schema": "https://opencode.ai/config.json",
  "skills": {
    "paths": ["skills"]
  },
  "permissions": [
    { "action": "external_directory", "resource": "/tmp/*", "effect": "allow" },
    { "action": "read", "resource": "/tmp/*", "effect": "allow" },
    { "action": "edit", "resource": "/tmp/*", "effect": "allow" },
    { "action": "shell", "resource": "/tmp/*", "effect": "allow" }
  ]
}
